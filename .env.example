# DataLens Environment Configuration Example
# Copy this file to .env or configure your environment variables accordingly.

# Environment mode ('development' or 'production')
DATALENS_ENV=development

# Server Host and Port
DATALENS_HOST=127.0.0.1
DATALENS_PORT=8000

# SQLite Database Connection String
# e.g., sqlite:///./storage/datalens.db
DATABASE_URL=sqlite:///./storage/datalens.db

# Storage Directory for Uploaded & Versioned CSV files
STORAGE_DIR=./storage

# Maximum Upload File Size in Bytes (default: 10485760 = 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# Allowed CORS Origins (comma-separated list for backend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Vite API Base URL (used during frontend build/dev)
VITE_API_BASE_URL=http://localhost:8000/api/v1
