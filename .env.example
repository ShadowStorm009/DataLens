# ==============================================================================
# DataLens Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT CONFIGURATION (Default)
# ------------------------------------------------------------------------------
# Environment mode ('development' or 'production')
DATALENS_ENV=development

# Server Host and Port for local dev
DATALENS_HOST=127.0.0.1
DATALENS_PORT=8000

# SQLite Database connection string (local file)
DATABASE_URL=sqlite:///./storage/datalens.db

# Storage directory for local dataset CSVs and profile caches
STORAGE_DIR=./storage

# Max upload limit in bytes (10 MB = 10485760)
MAX_UPLOAD_SIZE_BYTES=10485760

# Allowed CORS Origins for local development (comma-separated, no wildcards)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Frontend API base URL for local development (used by Vite dev server)
VITE_API_BASE_URL=http://localhost:8000/api/v1


# ------------------------------------------------------------------------------
# 2. RENDER BACKEND CONFIGURATION (Render Web Service Dashboard -> Environment)
# ------------------------------------------------------------------------------
# Set environment to production
# DATALENS_ENV=production

# Render automatically assigns PORT (usually 10000). Leave PORT unset on Render,
# or set DATALENS_PORT if needed. backend/Dockerfile.render binds to 0.0.0.0:${PORT:-10000}.
# DATALENS_HOST=0.0.0.0

# Persistent Disk mount path on Render (/app/storage)
# Mount a Persistent Disk at: /app/storage (e.g., 1 GB or 5 GB disk)
# DATABASE_URL=sqlite:////app/storage/datalens.db
# STORAGE_DIR=/app/storage
# MAX_UPLOAD_SIZE_BYTES=10485760

# Allowed CORS Origins: Set this to your deployed Vercel frontend origin!
# IMPORTANT: Replace with your actual Vercel deployment URL (no trailing slash).
# CORS_ORIGINS=https://<your-vercel-frontend-domain>.vercel.app


# ------------------------------------------------------------------------------
# 3. VERCEL FRONTEND CONFIGURATION (Vercel Project Settings -> Environment Variables)
# ------------------------------------------------------------------------------
# Target your deployed Render backend API URL.
# The client automatically appends /api/v1 if omitted, but best practice is:
# VITE_API_BASE_URL=https://<your-render-service-name>.onrender.com/api/v1

