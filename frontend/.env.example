# DataLens Frontend Environment Configuration Template for Vercel / Production
# Configure this in Vercel Project Settings -> Environment Variables

# Base URL pointing to your deployed Render FastAPI Backend.
# DataLens API client automatically appends '/api/v1' if omitted.
# Example: https://datalens-backend.onrender.com/api/v1
VITE_API_BASE_URL=https://<your-render-backend-name>.onrender.com/api/v1
